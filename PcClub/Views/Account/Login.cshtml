@model LoginForm
@{
    ViewData["Title"] = "Вход";
}

<section class="auth-layout">
    <div class="auth-photo">
        <img asp-append-version="true" src="/images/private.jpg" alt="Концепция приватной игровой комнаты"/>
        <div>
            <span class="eyebrow">WELCOME BACK</span>
            <h2>СВОИ<br/>УЖЕ ЗДЕСЬ.</h2>
        </div>
    </div>
    <div class="auth-content">
        <a href="/" class="muted small">← На главную</a>
        <span class="section-index">ТВОЙ АККАУНТ</span>
        <h1>С ВОЗВРАЩЕНИЕМ.</h1>
        <p class="muted">Войди, чтобы продолжить.</p>
        <form asp-action="Login" method="post" class="form-stack">
            <input asp-for="ReturnUrl" type="hidden"/>
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" type="email" required/>
                <span asp-validation-for="Email"></span>
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" required/>
                <span asp-validation-for="Password"></span>
            </div>
            <button class="button button-light" type="submit">Войти <span>↗</span></button>
        </form>
        <p class="auth-switch">Ещё не с нами? <a href="/account/register">Создать аккаунт ↗</a></p>
    </div>
</section>
