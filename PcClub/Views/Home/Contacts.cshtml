@inject IOptions<ClubOptions> ClubSettings
@{ ViewData["Title"] = "Контакты"; var club = ClubSettings.Value; }
<section class="page-heading container"><span class="section-index">PC CLUB / КОНТАКТЫ</span><h1>ИГРА СТАНОВИТСЯ<br />ЛУЧШЕ ВМЕСТЕ.</h1><p class="lead">Увидимся по эту сторону экрана.</p></section>
<section class="contact-layout container"><div class="contact-photo"><img asp-append-version="true" src="/images/lounge.jpg" alt="Концепция зоны отдыха" width="1360" height="768"/><span>МЕСТО ДЛЯ СВОИХ</span></div><div class="contact-details"><div><span class="eyebrow">ГДЕ МЫ</span><h2>@club.Address</h2></div><div><span class="eyebrow">КОГДА УВИДИМСЯ</span><p>@club.Hours</p></div><div><span class="eyebrow">СВЯЗЬ С КЛУБОМ</span>@if(!string.IsNullOrWhiteSpace(club.Phone)){<p><a href="tel:@club.Phone">@club.Phone</a></p>}@if(!string.IsNullOrWhiteSpace(club.Email)){<p><a href="mailto:@club.Email">@club.Email</a></p>}@if(string.IsNullOrWhiteSpace(club.Phone)&&string.IsNullOrWhiteSpace(club.Email)){<p class="muted">Контакты пока не указаны.<br/>Добавим их перед открытием.</p>}</div><a class="text-link" href="/services">А пока выбери игровую зону <span>↗</span></a></div></section>
