@model CatalogPage
@{ ViewData["Title"] = "Зоны и тарифы"; }
<section class="page-heading container"><span class="section-index">PC CLUB / ЗОНЫ И ТАРИФЫ</span><h1>ВЫБЕРИ СВОЮ<br />ТЕРРИТОРИЮ.</h1><div class="heading-bottom"><p class="lead">Один клуб. Разные способы быть в игре.</p><span class="muted small">Тарифы и оснащение демонстрационные</span></div></section>
<section class="catalog container"><nav class="filters" aria-label="Категории"><a href="/services" class="@(Model.CategoryId is null ? "selected" : "")" aria-current="@(Model.CategoryId is null ? "page" : null)">Все зоны</a>@foreach(var category in Model.Categories){<a href="/services?categoryId=@category.Id" class="@(Model.CategoryId==category.Id ? "selected" : "")" aria-current="@(Model.CategoryId==category.Id ? "page" : null)">@category.Name</a>}</nav>
@if(Model.Services.Count==0){<div class="empty-state"><h2>ПОКА ПУСТО</h2><p>В этой категории нет предложений.</p><a class="button button-light" href="/services">Показать все зоны ↗</a></div>}
<div class="catalog-grid">@foreach(var service in Model.Services){<article class="service-card"><a href="/services/@service.Id" class="service-image" aria-label="Подробнее: @service.Name"><img asp-append-version="true" src="@service.ImagePath" alt="Концепция @service.Name" loading="lazy" width="1360" height="768"/><span class="round-arrow">↗</span></a><div class="service-meta"><span>@service.Category?.Name</span><span>@service.Price.ToString("0.##") ₽ / @service.PriceUnit</span></div><h2><a href="/services/@service.Id">@service.Name</a></h2><p>@service.Summary</p><a href="/services/@service.Id" class="text-link">Подробнее о зоне <span>↗</span></a></article>}</div>
</section>
