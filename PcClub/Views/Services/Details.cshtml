@model ClubService
@{
    ViewData["Title"] = Model.Name;
}

<section class="detail-heading container">
    <nav class="breadcrumbs" aria-label="Путь к странице">
        <a href="/services">Зоны и тарифы</a>
        <span>/</span>
        <span>@Model.Name</span>
    </nav>
    <div class="section-heading">
        <h1>@Model.Name</h1>
        <span class="eyebrow">@Model.Category?.Name</span>
    </div>
    <p class="lead">@Model.Summary</p>
</section>

<div class="container detail-photo">
    <img
        asp-append-version="true"
        src="@Model.ImagePath"
        alt="Концепция зоны @Model.Name"
        width="1360"
        height="768"
    />
    <button
        class="expand-photo"
        type="button"
        data-gallery="@Model.ImagePath"
        data-caption="Концепция @Model.Name"
        aria-label="Увеличить фотографию"
    >
        ↗
    </button>
</div>
<section class="detail-body container">
    <div>
        <span class="section-index">О ПРОСТРАНСТВЕ</span>
        <p class="lead description">@Model.Description</p>
        <div class="spec-list">
            @foreach (var spec in Model.Specs.Split('•'))
            {
                <span>@spec.Trim()</span>
            }
        </div>
    </div>
    <aside class="price-box">
        <span class="eyebrow">ТВОЙ ФОРМАТ ИГРЫ</span>
        <div class="zone-price">
            <strong>@Model.Price.ToString("0.##") ₽</strong>
            <span>/ @Model.PriceUnit</span>
        </div>
        <p class="muted small">Демонстрационный тариф. Уточните доступность, стоимость и условия у клуба.</p>
        <a class="button button-light" href="/contacts">Контакты клуба <span>↗</span></a>
        <a class="text-link" href="/services">Другие зоны <span>↗</span></a>
    </aside>
</section>
